MYSQL_PASSWORD=khan_local
MYSQL_ROOT_PASSWORD=khan_root_local
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-change-me
ADMIN_USER=admin
REQUESTS_FALLBACK_EMAIL=demo@example.com

# SMTP (локально — Mailpit; на хостинге те же значения → wp-config.php)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Пусто / off — без TLS; tls — STARTTLS (587); ssl — SMTPS (465)
SMTP_SECURE=
SMTP_FROM=Хан-Хим <noreply@example.com>
