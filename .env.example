# База данных
DATABASE_URL=postgresql://khan:khan@127.0.0.1:5432/khan_him

# Payload (случайная строка ≥ 32 символов)
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# Публичный URL приложения (читается в рантайме; не NEXT_PUBLIC_*,
# иначе Next.js вшьёт значение при сборке образа)
SERVER_URL=http://localhost:3000

# Администратор (создаётся сидом)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# SMTP (локально — Mailpit)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Хан-Хим <noreply@localhost>"
REQUESTS_FALLBACK_EMAIL=requests@example.com

# Опционально: S3-совместимое хранилище (если не задано — диск uploads/)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# VPS с доменом и HTTPS (docker-compose.vps.yml):
# DOMAIN=example.ru
# SERVER_URL=https://example.ru
#
# VPS только по IP, без домена (docker-compose.vps-ip.yml):
# DOMAIN не нужен
# SERVER_URL=http://203.0.113.10
#
# POSTGRES_PASSWORD=change-me-strong-db-password
